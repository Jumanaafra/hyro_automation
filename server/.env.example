# ─────────────────────────────────────────────
# HYRO Automation — Server Environment Variables (Example)
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hyro_automation

# JWT Secret
JWT_SECRET=your_jwt_secret_change_in_production_32chars

# AES-256-CBC Encryption Key for OAuth tokens (MUST be 32 bytes = 64 hex chars)
CREDENTIAL_ENCRYPTION_KEY=4879726f4175746f6d6174696f6e4b657932303234486578313233343536373839

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# ─────────────────────────────────────────────
# AI Providers (optional)
# ─────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-...
# GEMINI_API_KEY=AIza...

# ─────────────────────────────────────────────
# OAuth Integrations (optional)
# ─────────────────────────────────────────────
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# GOOGLE_SHEETS_CLIENT_ID=...
# GOOGLE_SHEETS_CLIENT_SECRET=...
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...

# ─────────────────────────────────────────────
# Queue / Real-Time (optional)
# ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
