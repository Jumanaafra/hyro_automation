# ─────────────────────────────────────────────
# HYRO Automation — Server Environment Variables (Example)
# Copy this to .env and fill in real values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas URI — get from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hyro_automation?retryWrites=true&w=majority

# JWT — generate a strong random 32+ char string
JWT_SECRET=change_me_to_a_long_random_string_minimum_32_chars

# AES-256 Encryption Key for stored OAuth tokens (must be exactly 64 hex chars = 32 bytes)
CREDENTIAL_ENCRYPTION_KEY=4879726f4175746f6d6174696f6e4b657932303234486578313233343536373839

# Frontend URL (Vercel deployment URL — for CORS)
CLIENT_URL=https://your-app.vercel.app

# ─────────────────────────────────────────────
# AI Providers
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=...

# ─────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com
# ─────────────────────────────────────────────
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GOOGLE_SHEETS_CLIENT_ID=...
GOOGLE_SHEETS_CLIENT_SECRET=...

# Google Sheets default spreadsheet (optional — can be set per-node)
GOOGLE_SHEETS_SPREADSHEET_ID=...

# ─────────────────────────────────────────────
# LinkedIn OAuth (optional)
# ─────────────────────────────────────────────
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...

# ─────────────────────────────────────────────
# Slack (optional)
# ─────────────────────────────────────────────
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...

# ─────────────────────────────────────────────
# Redis / Queue (optional — in-memory fallback used without this)
# ─────────────────────────────────────────────
# REDIS_URL=redis://...
